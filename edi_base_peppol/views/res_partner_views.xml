<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_peppol_sending" model="ir.ui.view">
        <field name="name">res.partner.form.peppol.sending</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <!-- The delivery channel is a business setting here, not a debug one. -->
            <field name="invoice_sending_method" position="attributes">
                <attribute name="groups"/>
            </field>
            <field name="invoice_sending_method" position="after">
                <field name="peppol_sending_warning" invisible="not peppol_sending_warning"
                       class="text-warning" nolabel="1" colspan="2"/>
            </field>
        </field>
    </record>

    <record id="view_partner_form_peppol_smp" model="ir.ui.view">
        <field name="name">res.partner.form.peppol.smp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_edi_ubl_cii.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="peppol_endpoint" position="after">
                <div class="d-flex align-items-center gap-2" colspan="2"
                     invisible="not (peppol_eas and peppol_endpoint) and not vat">
                    <button name="action_peppol_smp_check" type="object"
                            string="Check on Peppol" icon="fa-search"
                            class="btn-link ps-0"
                            help="Ask the Peppol network whether this contact is registered and receives e-invoices. Without a Peppol address, the Slovak VAT number / DIČ is looked up."/>
                    <field name="peppol_smp_status" readonly="1" nolabel="1"
                           invisible="not peppol_smp_status"
                           decoration-success="peppol_smp_status == 'valid'"
                           decoration-warning="peppol_smp_status != 'valid'"
                           widget="badge"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
